# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET=your-secret-key-change-in-production

# Base de données (Supabase / PostgreSQL)
# Remplacez le mot de passe par celui de ta base Supabase. ?sslmode=require est requis.
# En local : URL directe (port 5432) OK.
# Sur Netlify / serverless : utiliser l’URL "Connection pooling" (port 6543, ...pooler.supabase.com) depuis Supabase → Database → Connection string.
DATABASE_URL=postgresql://postgres:REMPLACEZ_PAR_VOTRE_MOT_DE_PASSE@db.vedzbcstpkzstdwvixmx.supabase.co:5432/postgres?sslmode=require

# Airtable (optionnel pour le mode mock)
AIRTABLE_API_KEY=your_airtable_api_key
AIRTABLE_BASE_ID=your_airtable_base_id

# Mode mock (si true, utilise les données mockées au lieu d'Airtable)
USE_MOCK=true

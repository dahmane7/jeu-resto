# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET=your-secret-key-change-in-production

# Base de données (Supabase / PostgreSQL)
# Remplacez REMPLACEZ_PAR_VOTRE_MOT_DE_PASSE par le mot de passe de ta base Supabase
# Le ?sslmode=require est nécessaire pour la connexion Supabase
DATABASE_URL=postgresql://postgres:Start-zup2026@db.vedzbcstpkzstdwvixmx.supabase.co:5432/postgres?sslmode=require

# Airtable (optionnel pour le mode mock)
AIRTABLE_API_KEY=your_airtable_api_key
AIRTABLE_BASE_ID=your_airtable_base_id

# Mode mock (si true, utilise les données mockées au lieu d'Airtable)
USE_MOCK=true
